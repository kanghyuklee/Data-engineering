# 이 파일을 복사해서 ".env" 로 저장하고, 발급받은 토큰을 붙여넣으세요.
#   cp .env.example .env   (또는 파일 복사 후 이름만 .env 로)
# .env 는 .gitignore에 있어서 깃에 올라가지 않습니다 (토큰 노출 방지).

BRAWLSTARS_API_TOKEN=여기에_발급받은_토큰_붙여넣기

# --- DB·Grafana 자격증명 (로컬 개발 기본값. 공유/운영 시 반드시 변경) ---
# docker compose가 .env를 자동으로 읽어 ${VAR}에 주입합니다. 미설정 시 compose 기본값(brawl/admin) 사용.
POSTGRES_USER=brawl
POSTGRES_PASSWORD=brawl
POSTGRES_DB=brawlstars
GRAFANA_ADMIN_PASSWORD=admin

# 호스트에서 python 스크립트(combine_scores·match_fixing·upsert_detection) 실행 시 DB 접속
PG_USER=brawl
PG_PASSWORD=brawl
PG_DB=brawlstars
