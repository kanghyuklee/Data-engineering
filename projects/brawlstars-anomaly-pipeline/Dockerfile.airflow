# Airflow 실행용 커스텀 이미지
#   - docker CLI: spark_preprocess 태스크가 spark 컨테이너를 `docker exec` 하기 위함
#   - python deps: fetch/produce 태스크용 (requests·kafka-python·lz4)
FROM apache/airflow:2.9.2

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends docker.io \
 && rm -rf /var/lib/apt/lists/*

USER airflow
# fetch/produce 용(kafka-python·lz4·requests) + ML/그래프 탐지 용(scikit-learn·pyarrow)
#   numpy<2 고정: airflow 이미지의 pandas가 numpy 1.x로 빌드돼 있어, numpy 2.x를 깔면
#   'numpy.dtype size changed' ABI 충돌이 남 → 1.x로 맞춤.
RUN pip install --no-cache-dir kafka-python lz4 requests scikit-learn "numpy<2" pyarrow
